mappingId   PrimitiveValuePreStrokeMRS
target      data:PrimitiveValue_prestroke_mrs_{case_id} rdf:type scdm:QuantitativeResultValue ; btl2:hasValue {prestroke_mrs}^^xsd:integer.
source      SELECT "case_id", "prestroke_mrs" from "public"."strokehealthcaremodel_inpatientcase" where prestroke_mrs is not null

