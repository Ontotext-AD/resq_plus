source      SELECT "case_id", "prestroke_mrs" from "public"."strokehealthcaremodel_inpatientcase" where prestroke_mrs is not null


mappingId   PreStrokeMRS
target      data:ObservationResultSt_AdmissionExaminationMRS_prestroke_mrs_{case_id} rdf:type resq:AdmissionExaminationMRS ; scdm:hasObservable sct:1255866005 ; scdm:hasObservableValue data:PrimitiveValue_prestroke_mrs_{case_id} ; scdm:isResultOf data:Procedure_84100007_{case_id}.
