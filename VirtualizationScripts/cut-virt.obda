[PrefixDeclaration]
ex:         http://example.org/
owl:        http://www.w3.org/2002/07/owl#
rdf:        http://www.w3.org/1999/02/22-rdf-syntax-ns#
xml:        http://www.w3.org/XML/1998/namespace
xsd:        http://www.w3.org/2001/XMLSchema#
foaf:       http://xmlns.com/foaf/0.1/
obda:       https://w3id.org/obda/vocabulary#
rdfs:       http://www.w3.org/2000/01/rdf-schema#
sct:        http://snomed.info/id/
btl2:       http://purl.org/biotop/btl2.owl#
scdm:       http://www.semanticweb.org/catimc/SemanticCommonDataModel#
resq:       http://www.semanticweb.org/catimc/resqplus#
ofn:        http://www.ontotext.com/sparql/functions/
rin:        http://www.semanticweb.org/resqplus/instances#
data:       http://resqplus-resources/ontologies/resqplus-data#  

[MappingDeclaration] @collection [[ 


mappingId   ClinicalCaseID
target      data:Case_{case_id} a resq:ClinicalCase ; resq:caseId "{label}" .
source      SELECT si."case_id" as case_id , ss.case_id as label from "public"."strokehealthcaremodel_inpatientcase" si join "strokehealthcaremodel_casemodel" ss on si.case_id = ss.id

mappingId   ClinicalCaseProvider
target      data:Case_{case_id} a resq:ClinicalCase ; scdm:hasPart data:Provider_{provider_id} .
source      Select "case_id", "provider_id" from "public"."strokehealthcaremodel_inpatientcase"

mappingId   ClinicalCaseProviderStright
target      data:Case_{case_id} a resq:ClinicalCase ; scdm:hasProvider data:Provider_{provider_id} .
source      Select "case_id", "provider_id" from "public"."strokehealthcaremodel_inpatientcase"









mappingId   ClinicalCaseAdmissionData
target      data:Case_{case_id} a resq:ClinicalCase ; scdm:hasPart data:ObservationResultSt_AdmissionAge_age_{case_id} ; scdm:hasPart data:ClinicalSituationSt_AdmissionGender_sex_{case_id} ; scdm:hasPart data:ObservationResultSt_TimeArrivalToHospital_hospital_timestamp_{case_id} .
source      Select "case_id" from "public"."strokehealthcaremodel_inpatientcase"

mappingId   AdmissionProcedure
target      data:Procedure_32485007_{case_id} rdf:type sct:32485007.
source      SELECT "case_id" from strokehealthcaremodel_inpatientcase si



mappingId   ClinicalCaseAdmissionAgeStraight
target      data:Case_{case_id} a resq:ClinicalCase ; scdm:hasAge {age}^^xsd:integer.
source      SELECT "case_id" , "age" from strokehealthcaremodel_inpatientcase si

mappingId   Age
target      data:ObservationResultSt_AdmissionAge_age_{case_id} rdf:type resq:AdmissionAge ; scdm:isResultOf data:Procedure_32485007_{case_id} ; scdm:hasObservableValue data:PrimitiveValue_age_{case_id} ; scdm:hasObservable sct:445518008 .
source      SELECT "case_id" from strokehealthcaremodel_inpatientcase si

mappingId   AgeValue
target      data:PrimitiveValue_age_{case_id} rdf:type scdm:QuantitativeResultValue ; btl2:hasValue {age}^^xsd:integer.
source      SELECT "case_id" , "age" from strokehealthcaremodel_inpatientcase si



mappingId   ClinicalCaseAdmissionGenderMaleStraight
target      data:Case_{case_id} a resq:ClinicalCase ; scdm:hasGender sct:248153007 .
source      SELECT "case_id" from strokehealthcaremodel_inpatientcase si where sex_id = 1

mappingId   ClinicalCaseAdmissionGenderFemaleStraight
target      data:Case_{case_id} a resq:ClinicalCase ; scdm:hasGender sct:248152002 .
source      SELECT "case_id" from strokehealthcaremodel_inpatientcase si where sex_id = 2

mappingId   ClinicalCaseAdmissionGenderUnknownStraight
target      data:Case_{case_id} a resq:ClinicalCase ; scdm:hasGender sct:32570681000036106 .
source      SELECT "case_id" from strokehealthcaremodel_inpatientcase si where sex_id = 3 


mappingId   SexMale
target      data:ClinicalSituationSt_AdmissionGender_sex_{case_id} rdf:type resq:AdmissionGender ; scdm:isResultOf data:Procedure_32485007_{case_id} ; scdm:interpretsObservable sct:184100006 ; scdm:representsSituation sct:248153007 .
source      SELECT "case_id" from strokehealthcaremodel_inpatientcase si where sex_id = 1

mappingId   SexFemale
target      data:ClinicalSituationSt_AdmissionGender_sex_{case_id} rdf:type resq:AdmissionGender ; scdm:isResultOf data:Procedure_32485007_{case_id} ; scdm:interpretsObservable sct:184100006 ;  scdm:representsSituation sct:248152002.
source      SELECT "case_id" from strokehealthcaremodel_inpatientcase si where sex_id = 2

mappingId   SexOther
target      data:ClinicalSituationSt_AdmissionGender_sex_{case_id} rdf:type resq:AdmissionGender ; scdm:isResultOf data:Procedure_32485007_{case_id} ; scdm:interpretsObservable sct:184100006 ; scdm:representsSituation sct:32570681000036106.
source      SELECT "case_id" from strokehealthcaremodel_inpatientcase si where sex_id = 3




mappingId   ClinicalCaseArrivalDateStraight
target      data:Case_{case_id} a resq:ClinicalCase ; scdm:isArrivalAt {arrival_time}^^xsd:date.
source      select	case_id, date(hospital_timestamp) as arrival_time from public.strokehealthcaremodel_inpatientcase si 


mappingId   ClinicalCaseArrivalTimestampStraight
target      data:Case_{case_id} a resq:ClinicalCase ; scdm:isArrivalTimestamp {hospital_timestamp}^^xsd:dateTime.
source      select	case_id, hospital_timestamp from public.strokehealthcaremodel_inpatientcase si 


mappingId   HospitalTimestamp
target      data:ObservationResultSt_TimeArrivalToHospital_hospital_timestamp_{case_id} rdf:type resq:TimeArrivalToHospital ; scdm:isResultOf data:Procedure_32485007_{case_id} ; scdm:hasObservableValue data:PrimitiveValue_hospital_timestamp_{case_id} ; scdm:hasObservable sct:405799000.
source      SELECT "case_id" from strokehealthcaremodel_inpatientcase si

mappingId   HospitalTimestampValue
target      data:PrimitiveValue_hospital_timestamp_{case_id} rdf:type scdm:QuantitativeResultValue ; btl2:hasValue {hospital_timestamp}^^xsd:dateTime.
source      SELECT "case_id" , "hospital_timestamp" from strokehealthcaremodel_inpatientcase si
















mappingId   ClinicalCaseAdmissionExamination
target      data:Case_{case_id} a resq:ClinicalCase ; scdm:hasPart data:ObservationResultSt_AdmissionExaminationMRS_prestroke_mrs_{case_id} ; scdm:hasPart data:ObservationResultSt_AdmissionExaminationNIHSS_nihss_score_{case_id} ; scdm:hasPart data:ObservationResultSt_AdmissionExaminationCholesterol_cholesterol_{case_id} .
